#!/bin/sh
# Repository-local identity and no-coauthor policy.
expected='cambalacherp <223213695+cambalacherp@users.noreply.github.com>'
for identity in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
    case "$identity" in
        "$expected "*) ;;
        *) printf '%s\n' 'Commit rejected: author and committer must be cambalacherp with the configured GitHub noreply email.' >&2; exit 1 ;;
    esac
done
if LC_ALL=C grep -Eiq '^[[:space:]]*co[-[:space:]]*author(ed)?s?([-[:space:]]*by)?[[:space:]]*:' "$1"; then
    printf '%s\n' 'Commit rejected: coauthor attribution is not allowed in this repository.' >&2
    exit 1
fi
exit 0
