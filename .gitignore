# Python bytecode and local environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Generated skin builds and previews (keep deliverables local to each build)
/output/
/output_kitbash_suite/

# Operating-system metadata and transient logs
.DS_Store
Thumbs.db
desktop.ini
*.log

# Blender automatic backups and reproducible render-worker input
*.blend[0-9]*
*.blend1
*.blend2

# Graphify local caches, incremental timestamps, and temporary pipeline state
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/.graphify_*
/graphify-out/.needs_update

# Keep portable community labels alongside graph.json, graph.html and the report
!/graphify-out/.graphify_labels.json
!/graphify-out/.graphify_labels.json.sig

# Automatically generated dated backups of the portable graph
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
